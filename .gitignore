# GapLens AI — Root .gitignore

# ─── Frontend ────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.tsbuildinfo

# ─── Backend ─────────────────────────────────────────────
backend/.env
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/db.sqlite3
backend/gaplens.sqlite3
*.sqlite3
backend/staticfiles/
backend/media/
backend/venv/
backend/.venv/

# ─── Python ──────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
build/
*.egg
.eggs/
.Python
pip-log.txt

# ─── AI / ML ─────────────────────────────────────────────
backend/faiss_index/
backend/*.faiss
backend/*.index
*.pkl
*.npy

# ─── OS ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── IDE ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Logs ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ────────────────────────────────────────────────
.env
.env.local
.env.example.bak
# Secrets and local environment files
.env
.env.*
**/.env
**/.env.*
!/.env.example

# Local databases
*.sqlite
*.sqlite3
*.db

# User-uploaded files
uploads/
media/
backend/uploads/
backend/media/
backend/user_uploads/
