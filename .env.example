# ==============================================================================
# GapLens AI — Root Environment Reference
# ==============================================================================
# Copy this file to backend/.env and fill in your values.
# Never commit .env files to version control.

# ─── Django Core ─────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

# ─── Database (SQLite default — no configuration needed) ─
# Leave blank to use SQLite for local development.
DATABASE_URL=

# ─── AI — Google Gemini (Primary) ────────────────────────
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.8-flash



# ─── Email (Optional) ─────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
